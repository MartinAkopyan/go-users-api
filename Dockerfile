# ---- Стейдж 1: сборка ----

# Базовый образ с компилятором Go. AS builder даёт стейджу имя,
# чтобы потом забрать из него файлы во втором стейдже.
FROM golang:1.26.5 AS builder

# Рабочая директория внутри контейнера. Все команды ниже (COPY, RUN)
# выполняются относительно /app. Если папки нет, Docker её создаст.
WORKDIR /app

# Копируем только файлы зависимостей, без кода.
# go.mod: список модулей и версий, go.sum: их контрольные суммы.
COPY go.mod .
COPY go.sum .

# Скачиваем зависимости. Docker кэширует каждый шаг как слой: пока go.mod
# и go.sum не менялись, этот слой берётся из кэша и модули не качаются заново.
# Поэтому код копируется только после этого шага.
RUN go mod download

# Копируем весь остальной проект (кроме того, что в .dockerignore).
COPY . .

# Компилируем пакет main из cmd/api в бинарник /app/server.
# CGO_ENABLED=0 отключает вызовы C-кода: бинарник получается статическим
# и не требует glibc, поэтому подойдёт образ distroless/static.
RUN CGO_ENABLED=0 go build -o server ./cmd/api/

# ---- Стейдж 2: финальный образ ----

# Новый стейдж с нуля: минимальный образ без shell, компилятора и glibc.
# Всё из стейджа builder сюда не попадает, только то, что скопируем явно.
FROM gcr.io/distroless/static

# Забираем из стейджа builder только готовый бинарник.
# Исходники, модули и компилятор остаются в builder и в образ не попадают.
COPY --from=builder /app/server /server

# Команда, которая выполняется при запуске контейнера.
# Форма с массивом (exec form) запускает бинарник напрямую, без shell,
# которого в distroless всё равно нет.
CMD ["/server"]
